# ==============================
# Flask core settings
# ==============================
FLASK_ENV=development
SECRET_KEY=change-this-secret-key

# ==============================
# PostgreSQL connection (SQLAlchemy)
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
# ==============================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transiti_fy

# ==============================
# JWT Authentication
# ==============================
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# ==============================
# Cloudinary (image uploads - driver photos, vehicle docs, etc.)
# ==============================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==============================
# Brevo (transactional email - license expiry reminders, alerts)
# ==============================
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@transiti-fy.example
BREVO_SENDER_NAME=transiti-fy

# ==============================
# Frontend URL (used for CORS + email links)
# ==============================
FRONTEND_URL=http://localhost:5173
